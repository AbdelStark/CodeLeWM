#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
"""Flatten an unpacked IBM Project_CodeNet Python tree into adapter JSONL.

CodeNet is too large for the public CI matrix (~150 GB raw) so this
flattener operates on a *locally extracted* copy. The expected layout
is the canonical Project_CodeNet release:

::

    <root>/
      data/<problem_id>/Python/<submission_id>.py     # Python submissions
      metadata/<problem_id>.csv                        # judge_verdict per submission
      derived/input_output/data/<problem_id>/input.txt # test input(s)
      derived/input_output/data/<problem_id>/output.txt # expected output(s)

This is intentionally read-only and offline: it never downloads from
the network. The user obtains CodeNet from the IBM repo separately.
The flattened JSONL is consumed by the existing CodeNet adapter
(:mod:`codelewm.data.execution_sources`) which produces stdin-style
``SourceSubmission`` records.

Per-language filter: only Python submissions are emitted. Per-status
filter: by default only accepted submissions, since wrong-answer
submissions are not guaranteed to be deterministic under the sandbox
policy.
"""

from __future__ import annotations

import argparse
import csv
import json
import sys
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--root",
        type=Path,
        required=True,
        help="Project_CodeNet extraction root (must contain data/, metadata/, derived/)",
    )
    parser.add_argument(
        "--output", type=Path, required=True, help="output JSONL path"
    )
    parser.add_argument(
        "--max-submissions-per-problem",
        type=int,
        default=3,
        help="cap submissions kept per problem",
    )
    parser.add_argument(
        "--keep-verdicts",
        default="accepted",
        help="comma-separated judge verdicts to keep (default: accepted)",
    )
    parser.add_argument(
        "--max-code-bytes",
        type=int,
        default=64 * 1024,
        help="drop submissions larger than this many UTF-8 bytes",
    )
    parser.add_argument(
        "--license",
        default="Apache-2.0",
        help="license tag stamped onto every record (per CodeNet README)",
    )
    parser.add_argument(
        "--license-url",
        default="https://github.com/IBM/Project_CodeNet",
        help="attribution URL stamped onto every record",
    )
    parser.add_argument(
        "--limit", type=int, default=None, help="cap total problems written"
    )
    args = parser.parse_args()

    if not args.root.is_dir():
        print(
            f"error: --root {args.root} must be a directory",
            file=sys.stderr,
        )
        return 2

    data_root = args.root / "data"
    metadata_root = args.root / "metadata"
    io_root = args.root / "derived" / "input_output" / "data"
    for path in (data_root, metadata_root, io_root):
        if not path.is_dir():
            print(
                f"error: expected directory missing: {path}",
                file=sys.stderr,
            )
            return 2

    keep_verdicts = {
        v.strip().lower().replace(" ", "_") for v in args.keep_verdicts.split(",") if v.strip()
    }
    args.output.parent.mkdir(parents=True, exist_ok=True)

    written = 0
    skipped: dict[str, int] = {}
    with args.output.open("w", encoding="utf-8") as fh:
        for problem_dir in sorted(data_root.iterdir()):
            if args.limit is not None and written >= args.limit:
                break
            if not problem_dir.is_dir():
                continue
            problem_id = problem_dir.name
            python_dir = problem_dir / "Python"
            if not python_dir.is_dir():
                skipped["no_python_submissions"] = (
                    skipped.get("no_python_submissions", 0) + 1
                )
                continue
            test_cases = _read_io_pairs(io_root / problem_id)
            if not test_cases:
                skipped["no_test_cases"] = skipped.get("no_test_cases", 0) + 1
                continue
            verdicts = _read_verdicts(metadata_root / f"{problem_id}.csv")
            kept = 0
            for submission_path in sorted(python_dir.iterdir()):
                if kept >= args.max_submissions_per_problem:
                    break
                if not submission_path.is_file() or submission_path.suffix != ".py":
                    continue
                submission_id = submission_path.stem
                verdict = verdicts.get(submission_id)
                if keep_verdicts and (verdict is None or verdict not in keep_verdicts):
                    skipped["verdict_filtered"] = (
                        skipped.get("verdict_filtered", 0) + 1
                    )
                    continue
                try:
                    code = submission_path.read_text(encoding="utf-8")
                except (UnicodeDecodeError, OSError):
                    skipped["unicode_or_read_error"] = (
                        skipped.get("unicode_or_read_error", 0) + 1
                    )
                    continue
                if len(code.encode("utf-8")) > args.max_code_bytes:
                    skipped["code_too_large"] = (
                        skipped.get("code_too_large", 0) + 1
                    )
                    continue
                row = {
                    "problem_id": problem_id,
                    "submission_id": f"{problem_id}/{submission_id}",
                    "language": "Python",
                    "license": args.license,
                    "license_url": args.license_url,
                    "code": code,
                    "judge_verdict": verdict,
                    "test_cases": test_cases,
                }
                fh.write(json.dumps(row, ensure_ascii=False))
                fh.write("\n")
                written += 1
                kept += 1
                if args.limit is not None and written >= args.limit:
                    break

    summary = {
        "root": str(args.root),
        "output": str(args.output),
        "rows_written": written,
        "rows_skipped_by_reason": dict(sorted(skipped.items())),
        "keep_verdicts": sorted(keep_verdicts),
    }
    print(json.dumps(summary, indent=2, sort_keys=True))
    return 0 if written > 0 else 1


def _read_io_pairs(problem_io_dir: Path) -> list[dict[str, str]]:
    if not problem_io_dir.is_dir():
        return []
    cases: list[dict[str, str]] = []
    input_file = problem_io_dir / "input.txt"
    output_file = problem_io_dir / "output.txt"
    if not (input_file.is_file() and output_file.is_file()):
        return []
    try:
        input_text = input_file.read_text(encoding="utf-8")
        output_text = output_file.read_text(encoding="utf-8")
    except (UnicodeDecodeError, OSError):
        return []
    cases.append(
        {
            "input_id": "case-0",
            "input": input_text,
            "expected_output": output_text,
        }
    )
    return cases


def _read_verdicts(metadata_csv: Path) -> dict[str, str]:
    if not metadata_csv.is_file():
        return {}
    verdicts: dict[str, str] = {}
    try:
        with metadata_csv.open(encoding="utf-8", newline="") as fh:
            reader = csv.DictReader(fh)
            for row in reader:
                submission_id = row.get("submission_id") or row.get("id")
                if not submission_id:
                    continue
                raw = row.get("status") or row.get("verdict") or ""
                verdicts[submission_id] = raw.strip().lower().replace(" ", "_")
    except OSError:
        return {}
    return verdicts


if __name__ == "__main__":
    sys.exit(main())
