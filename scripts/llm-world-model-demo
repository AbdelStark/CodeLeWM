#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

if [[ -f .env ]]; then
  __codelewm_env_keys=(
    CODELEWM_LLM_PROVIDER
    CODELEWM_LLM_MODEL
    CODELEWM_LLM_MAX_CANDIDATES
    CODELEWM_LLM_TIMEOUT_SECONDS
    CODELEWM_LLM_TEMPERATURE
    CODELEWM_LLM_DRY_RUN
    CODELEWM_LLM_RETRY_LIMIT
    CODELEWM_LLM_PROVIDER_OPTIONS_JSON
    CODELEWM_OPENROUTER_BYOK
    CODELEWM_OPENROUTER_BYOK_PROVIDER
    CODELEWM_OPENROUTER_BYOK_KEY_ENV
    CODELEWM_OPENROUTER_BYOK_MANAGEMENT_KEY_ENV
    CODELEWM_OPENROUTER_BYOK_REQUIRE
    CODELEWM_OPENROUTER_BYOK_REGISTER
    CODELEWM_OPENROUTER_BYOK_DRY_RUN
    CODELEWM_OPENROUTER_BYOK_NAME
    CODELEWM_OPENROUTER_BYOK_ALLOWED_MODELS
    CODELEWM_OPENROUTER_BYOK_WORKSPACE_ID
    CODELEWM_OPENROUTER_BYOK_IS_FALLBACK
    CODELEWM_LLM_DEMO_ROOT
    CODELEWM_LLM_DEMO_BEFORE
    CODELEWM_LLM_DEMO_CHECKPOINT
    CODELEWM_LLM_DEMO_TASK_ID
    CODELEWM_LLM_DEMO_INSTRUCTION
    CODELEWM_LLM_DEMO_OUT
    OPENROUTER_API_KEY
    OPENROUTER_MANAGEMENT_KEY
    OPENROUTER_HTTP_REFERER
    OPENROUTER_APP_TITLE
    ANTHROPIC_API_KEY
  )
  __codelewm_restore_keys=()
  __codelewm_restore_values=()
  for key in "${__codelewm_env_keys[@]}"; do
    if [[ ${!key+x} ]]; then
      __codelewm_restore_keys+=("$key")
      __codelewm_restore_values+=("${!key}")
    fi
  done
  set -a
  # shellcheck disable=SC1091
  . ./.env
  set +a
  for i in "${!__codelewm_restore_keys[@]}"; do
    export "${__codelewm_restore_keys[$i]}=${__codelewm_restore_values[$i]}"
  done
  unset __codelewm_env_keys __codelewm_restore_keys __codelewm_restore_values
fi

export CODELEWM_LLM_PROVIDER="${CODELEWM_LLM_PROVIDER:-openrouter}"
export CODELEWM_LLM_MODEL="${CODELEWM_LLM_MODEL:-anthropic/claude-4.5-sonnet}"
export CODELEWM_LLM_MAX_CANDIDATES="${CODELEWM_LLM_MAX_CANDIDATES:-2}"
export CODELEWM_LLM_TIMEOUT_SECONDS="${CODELEWM_LLM_TIMEOUT_SECONDS:-120}"
export CODELEWM_LLM_TEMPERATURE="${CODELEWM_LLM_TEMPERATURE:-0.2}"
export CODELEWM_LLM_DRY_RUN="${CODELEWM_LLM_DRY_RUN:-1}"
export CODELEWM_LLM_RETRY_LIMIT="${CODELEWM_LLM_RETRY_LIMIT:-2}"
export OPENROUTER_APP_TITLE="${OPENROUTER_APP_TITLE:-CodeLeWM}"

demo_root="${CODELEWM_LLM_DEMO_ROOT:-.artifacts/llm-world-model-demo}"
before_path="${CODELEWM_LLM_DEMO_BEFORE:-$demo_root/input/app.py}"
checkpoint="${CODELEWM_LLM_DEMO_CHECKPOINT:-.artifacts/first-results/train/checkpoints/checkpoint.pt}"
task_id="${CODELEWM_LLM_DEMO_TASK_ID:-codelewm-llm-world-model-demo}"
instruction="${CODELEWM_LLM_DEMO_INSTRUCTION:-Add a deterministic comment candidate while preserving the value assignment.}"
out_dir="${CODELEWM_LLM_DEMO_OUT:-$demo_root/run}"

if [[ ! -f "$checkpoint" ]]; then
  uv run scripts/first-results --overwrite
fi

mkdir -p "$(dirname "$before_path")"
cat > "$before_path" <<'PY'
value = 1
PY

rm -rf "$out_dir"
uv run codelewm llm-demo \
  --before "$before_path" \
  --instruction "$instruction" \
  --checkpoint "$checkpoint" \
  --out "$out_dir" \
  --task-id "$task_id" \
  --context-path app.py \
  --allow-unsafe-checkpoint \
  --overwrite \
  --json

uv run codelewm manifest verify \
  --manifest "$out_dir/manifest.json" \
  --parent-manifest "$out_dir/candidate_pack/manifest.json" \
  --json

uv run codelewm secret-scan "$out_dir" --json
uv run codelewm secret-scan "$out_dir/demo.html" --include-suffix .html --json

printf 'visual_report: %s\n' "$out_dir/demo.html"
