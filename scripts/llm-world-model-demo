#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
uv_run=(uv run --group data --group train --group llm)
uv_light_run=(uv run)
cli_output_mode=""
cli_scenario=""
list_scenarios=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --json)
      cli_output_mode="json"
      shift
      ;;
    --visual)
      cli_output_mode="visual"
      shift
      ;;
    --scenario)
      if [[ $# -lt 2 ]]; then
        printf '%s\n' '--scenario requires a scenario id' >&2
        exit 2
      fi
      cli_scenario="$2"
      shift 2
      ;;
    --list-scenarios)
      list_scenarios=1
      shift
      ;;
    -h|--help)
      cat <<'EOF'
Usage: scripts/llm-world-model-demo [--visual|--json] [--scenario ID]

Runs the local LLM + CodeLeWM demo.

Default scenario: bugfix-edge-case

Default output is a visual terminal walkthrough. Use --json or set
CODELEWM_LLM_DEMO_OUTPUT=json for raw machine-readable command output.
EOF
      exit 0
      ;;
    *)
      printf 'unknown option: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

__codelewm_pre_demo_before="${CODELEWM_LLM_DEMO_BEFORE+x}"
__codelewm_pre_demo_context_path="${CODELEWM_LLM_DEMO_CONTEXT_PATH+x}"
__codelewm_pre_demo_task_id="${CODELEWM_LLM_DEMO_TASK_ID+x}"
__codelewm_pre_demo_instruction="${CODELEWM_LLM_DEMO_INSTRUCTION+x}"
__codelewm_pre_prompt_template="${CODELEWM_LLM_PROMPT_TEMPLATE_ID+x}"

if [[ -f .env ]]; then
  __codelewm_env_keys=(
    CODELEWM_LLM_PROVIDER
    CODELEWM_LLM_MODEL
    CODELEWM_LLM_MAX_CANDIDATES
    CODELEWM_LLM_TIMEOUT_SECONDS
    CODELEWM_LLM_TEMPERATURE
    CODELEWM_LLM_DRY_RUN
    CODELEWM_LLM_RETRY_LIMIT
    CODELEWM_LLM_PROMPT_TEMPLATE_ID
    CODELEWM_LLM_PROVIDER_OPTIONS_JSON
    CODELEWM_OPENROUTER_BYOK
    CODELEWM_OPENROUTER_BYOK_PROVIDER
    CODELEWM_OPENROUTER_BYOK_KEY_ENV
    CODELEWM_OPENROUTER_BYOK_MANAGEMENT_KEY_ENV
    CODELEWM_OPENROUTER_BYOK_REQUIRE
    CODELEWM_OPENROUTER_BYOK_REGISTER
    CODELEWM_OPENROUTER_BYOK_DRY_RUN
    CODELEWM_OPENROUTER_BYOK_NAME
    CODELEWM_OPENROUTER_BYOK_ALLOWED_MODELS
    CODELEWM_OPENROUTER_BYOK_WORKSPACE_ID
    CODELEWM_OPENROUTER_BYOK_IS_FALLBACK
    CODELEWM_LLM_DEMO_ROOT
    CODELEWM_LLM_DEMO_SCENARIO
    CODELEWM_LLM_DEMO_BEFORE
    CODELEWM_LLM_DEMO_CONTEXT_PATH
    CODELEWM_LLM_DEMO_CHECKPOINT
    CODELEWM_LLM_DEMO_TASK_ID
    CODELEWM_LLM_DEMO_INSTRUCTION
    CODELEWM_LLM_DEMO_OUT
    CODELEWM_LLM_DEMO_DEVICE
    CODELEWM_LLM_DEMO_OUTPUT
    OPENROUTER_API_KEY
    OPENROUTER_MANAGEMENT_KEY
    OPENROUTER_HTTP_REFERER
    OPENROUTER_APP_TITLE
    ANTHROPIC_API_KEY
  )
  __codelewm_restore_keys=()
  __codelewm_restore_values=()
  for key in "${__codelewm_env_keys[@]}"; do
    if [[ ${!key+x} ]]; then
      __codelewm_restore_keys+=("$key")
      __codelewm_restore_values+=("${!key}")
    fi
  done
  set -a
  # shellcheck disable=SC1091
  . ./.env
  set +a
  for i in "${!__codelewm_restore_keys[@]}"; do
    export "${__codelewm_restore_keys[$i]}=${__codelewm_restore_values[$i]}"
  done
  unset __codelewm_env_keys __codelewm_restore_keys __codelewm_restore_values
fi

export CODELEWM_LLM_PROVIDER="${CODELEWM_LLM_PROVIDER:-openrouter}"
export CODELEWM_LLM_MODEL="${CODELEWM_LLM_MODEL:-anthropic/claude-4.5-sonnet}"
export CODELEWM_LLM_MAX_CANDIDATES="${CODELEWM_LLM_MAX_CANDIDATES:-2}"
export CODELEWM_LLM_TIMEOUT_SECONDS="${CODELEWM_LLM_TIMEOUT_SECONDS:-120}"
export CODELEWM_LLM_TEMPERATURE="${CODELEWM_LLM_TEMPERATURE:-0.2}"
export CODELEWM_LLM_DRY_RUN="${CODELEWM_LLM_DRY_RUN:-1}"
export CODELEWM_LLM_RETRY_LIMIT="${CODELEWM_LLM_RETRY_LIMIT:-2}"
export OPENROUTER_APP_TITLE="${OPENROUTER_APP_TITLE:-CodeLeWM}"

if [[ "$list_scenarios" == "1" ]]; then
  "${uv_light_run[@]}" python -c 'from codelewm.harness.demo_scenarios import main; raise SystemExit(main())' \
    --root .artifacts/llm-world-model-demo/input --list --json
  exit 0
fi

demo_root="${CODELEWM_LLM_DEMO_ROOT:-.artifacts/llm-world-model-demo}"
scenario_id="${cli_scenario:-${CODELEWM_LLM_DEMO_SCENARIO:-bugfix-edge-case}}"
checkpoint="${CODELEWM_LLM_DEMO_CHECKPOINT:-.artifacts/first-results/train/checkpoints/checkpoint.pt}"
out_dir="${CODELEWM_LLM_DEMO_OUT:-$demo_root/run}"
device="${CODELEWM_LLM_DEMO_DEVICE:-cpu}"
output_mode="${cli_output_mode:-${CODELEWM_LLM_DEMO_OUTPUT:-visual}}"

if [[ "$output_mode" != "visual" && "$output_mode" != "json" ]]; then
  printf 'CODELEWM_LLM_DEMO_OUTPUT must be visual or json; got %s\n' "$output_mode" >&2
  exit 2
fi

tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT
demo_run_json="$tmp_dir/demo_run.json"
manifest_verify_json="$tmp_dir/manifest_verify.json"
secret_scan_json="$tmp_dir/secret_scan.json"
html_secret_scan_json="$tmp_dir/html_secret_scan.json"
scenario_env="$tmp_dir/scenario.env"

run_json() {
  local label="$1"
  local output="$2"
  shift 2
  local stderr_file="$tmp_dir/${label//[^A-Za-z0-9_]/_}.stderr"
  if [[ "$output_mode" == "visual" ]]; then
    printf '[run] %s\n' "$label"
  fi
  if ! "$@" >"$output" 2>"$stderr_file"; then
    printf '[fail] %s\n' "$label" >&2
    if [[ -s "$output" ]]; then
      cat "$output" >&2
    fi
    if [[ -s "$stderr_file" ]]; then
      sed -n '1,80p' "$stderr_file" >&2
    fi
    exit 1
  fi
}

if [[ "$output_mode" == "visual" ]]; then
  printf 'CodeLeWM demo runner\n'
fi

"${uv_run[@]}" python -c 'from codelewm.harness.demo_scenarios import main; raise SystemExit(main())' \
  --scenario "$scenario_id" \
  --root "$demo_root/input" \
  --shell-env-file "$scenario_env" >/dev/null
# shellcheck disable=SC1090
. "$scenario_env"

if [[ -n "$__codelewm_pre_demo_before" ]]; then
  before_path="$CODELEWM_LLM_DEMO_BEFORE"
else
  before_path="$CODELEWM_LLM_DEMO_SCENARIO_BEFORE"
fi
if [[ -n "$__codelewm_pre_demo_context_path" ]]; then
  context_path="$CODELEWM_LLM_DEMO_CONTEXT_PATH"
else
  context_path="$CODELEWM_LLM_DEMO_SCENARIO_CONTEXT_PATH"
fi
if [[ -n "$__codelewm_pre_demo_task_id" ]]; then
  task_id="$CODELEWM_LLM_DEMO_TASK_ID"
else
  task_id="$CODELEWM_LLM_DEMO_SCENARIO_TASK_ID"
fi
if [[ -n "$__codelewm_pre_demo_instruction" ]]; then
  instruction="$CODELEWM_LLM_DEMO_INSTRUCTION"
else
  instruction="$CODELEWM_LLM_DEMO_SCENARIO_INSTRUCTION"
fi
if [[ -n "$__codelewm_pre_prompt_template" ]]; then
  export CODELEWM_LLM_PROMPT_TEMPLATE_ID
else
  export CODELEWM_LLM_PROMPT_TEMPLATE_ID="$CODELEWM_LLM_DEMO_SCENARIO_PROMPT_TEMPLATE_ID"
fi

if [[ ! -f "$before_path" ]]; then
  mkdir -p "$(dirname "$before_path")"
  cp "$CODELEWM_LLM_DEMO_SCENARIO_BEFORE" "$before_path"
fi

if [[ "$output_mode" == "visual" ]]; then
  printf 'mode=%s model=%s device=%s out=%s\n' \
    "$([[ "$CODELEWM_LLM_DRY_RUN" == "1" ]] && printf 'fixture' || printf 'live')" \
    "$CODELEWM_LLM_MODEL" \
    "$device" \
    "$out_dir"
  printf 'scenario=%s title=%s\n\n' \
    "$CODELEWM_LLM_DEMO_SCENARIO_ID" \
    "$CODELEWM_LLM_DEMO_SCENARIO_TITLE"
fi

if [[ ! -f "$checkpoint" ]]; then
  if [[ "$output_mode" == "visual" ]]; then
    printf '[run] first-results checkpoint missing, regenerating local smoke artifacts\n'
  fi
  "${uv_run[@]}" scripts/first-results --overwrite
fi

rm -rf "$out_dir"
run_json "candidate generation + learned world-model scoring" "$demo_run_json" \
  "${uv_run[@]}" codelewm llm-demo \
  --before "$before_path" \
  --instruction "$instruction" \
  --checkpoint "$checkpoint" \
  --out "$out_dir" \
  --task-id "$task_id" \
  --context-path "$context_path" \
  --device "$device" \
  --require-learned-scorer \
  --overwrite \
  --json

run_json "manifest verification" "$manifest_verify_json" \
  "${uv_run[@]}" codelewm manifest verify \
  --manifest "$out_dir/manifest.json" \
  --parent-manifest "$out_dir/candidate_pack/manifest.json" \
  --json

run_json "artifact secret scan" "$secret_scan_json" \
  "${uv_run[@]}" codelewm secret-scan "$out_dir" --json
run_json "HTML secret scan" "$html_secret_scan_json" \
  "${uv_run[@]}" codelewm secret-scan "$out_dir/demo.html" --include-suffix .html --json

if [[ "$output_mode" == "json" ]]; then
  cat "$demo_run_json"
  cat "$manifest_verify_json"
  cat "$secret_scan_json"
  cat "$html_secret_scan_json"
  printf 'visual_report: %s\n' "$out_dir/demo.html"
else
  "${uv_run[@]}" python -m codelewm.harness.demo_terminal \
    --demo-run "$demo_run_json" \
    --manifest-verify "$manifest_verify_json" \
    --secret-scan "$secret_scan_json" \
    --html-secret-scan "$html_secret_scan_json" \
    --report "$out_dir/reports/llm_world_model_demo_report.json" \
    --candidate-pack "$out_dir/candidate_pack/candidate_pack.json" \
    --out-dir "$out_dir"
fi
