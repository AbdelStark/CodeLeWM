#!/usr/bin/env python
"""Build a WS-D unsaturated rerank pack from mutation distractors.

Generates plausible near-miss variants of each problem's known-correct
reference solution, labels them in the CodeLeWM sandbox, and emits a
``completion_label.v1`` pack with a pass/fail mix per problem (so reranking
has real headroom, unlike the saturated frontier-LLM packs). Deterministic
and offline: no LLM, no provider budget.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from codelewm.data.execution_rerank_sampler import (
    CompletionSamplingError,
    build_mutation_rerank_pack,
    policy_from_args,
)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Build an unsaturated WS-D rerank pack from AST mutation distractors."
    )
    parser.add_argument("--benchmark", required=True, help="humaneval | mbpp-plus")
    parser.add_argument("--source", required=True, type=Path, help="raw source JSONL")
    parser.add_argument("--out", required=True, type=Path, help="output pack directory")
    parser.add_argument("--mutants-per-problem", type=int, default=12)
    parser.add_argument("--pool-size", type=int, default=6,
                        help="candidates per problem (1 reference + pool_size-1 distractors)")
    parser.add_argument("--seed", type=int, default=17)
    parser.add_argument("--max-problems", type=int, default=None)
    parser.add_argument("--max-cases-per-problem", type=int, default=None)
    parser.add_argument("--timeout-ms", type=int, default=5000)
    parser.add_argument("--memory-mb", type=int, default=256)
    parser.add_argument("--cpu-seconds", type=int, default=10)
    parser.add_argument("--overwrite", action="store_true")
    parser.add_argument("--allow-secret-findings", action="store_true")
    parser.add_argument("--json", action="store_true", help="emit JSON summary")
    args = parser.parse_args(argv)

    try:
        result = build_mutation_rerank_pack(
            benchmark=args.benchmark,
            source_path=args.source,
            out=args.out,
            mutants_per_problem=args.mutants_per_problem,
            pool_size=args.pool_size,
            seed=args.seed,
            max_problems=args.max_problems,
            max_cases_per_problem=args.max_cases_per_problem,
            sandbox_policy=policy_from_args(
                timeout_ms=args.timeout_ms,
                memory_mb=args.memory_mb,
                cpu_seconds=args.cpu_seconds,
                determinism_check=True,
            ),
            overwrite=args.overwrite,
            allow_secret_findings=args.allow_secret_findings,
            command=("scripts/build-wsd-rerank-pack", *(argv or sys.argv[1:])),
        )
    except CompletionSamplingError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    if args.json:
        print(json.dumps(result.to_dict(), indent=2, sort_keys=True))
    else:
        print(f"benchmark: {result.benchmark_id}")
        print(f"kept_problems: {result.problem_count}")
        print(f"completions: {result.completion_count}")
        print(f"passed_completions: {result.passed_completion_count}")
        print(f"pack: {result.output_dir}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
