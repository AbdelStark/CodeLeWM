#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
PAPER_DIR="$ROOT/docs/papers"
BUILD_DIR="$PAPER_DIR/arxiv/codelewm_final_paper"

cd "$PAPER_DIR"
tectonic codelewm_final_paper.tex

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cp codelewm_final_paper.tex two_substrate_references.bib codelewm_final_paper.pdf "$BUILD_DIR/"
tar -czf "$PAPER_DIR/codelewm_final_arxiv_source.tar.gz" \
  -C "$BUILD_DIR" \
  codelewm_final_paper.tex \
  two_substrate_references.bib

printf 'pdf: %s\n' "$PAPER_DIR/codelewm_final_paper.pdf"
printf 'arxiv_source: %s\n' "$PAPER_DIR/codelewm_final_arxiv_source.tar.gz"
