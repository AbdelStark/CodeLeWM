#!/usr/bin/env python
"""Build a v0.8 pass/fail execution pack from completion-label artifacts."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from codelewm.data.execution_pack.build_passfail_pack import (
    PassFailPackBuilderError,
    build_passfail_pack,
)
from codelewm.data.execution_rerank_sampler import policy_from_args


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--completion-labels",
        type=Path,
        action="append",
        required=True,
        help="completion_label.v1 JSONL path; repeatable",
    )
    parser.add_argument(
        "--source",
        type=Path,
        required=True,
        help="raw benchmark source JSONL used to build the completion labels",
    )
    parser.add_argument(
        "--benchmark",
        required=True,
        help="source adapter name, e.g. mbpp, humaneval, or mbpp-plus",
    )
    parser.add_argument("--out", type=Path, required=True, help="output pack directory")
    parser.add_argument("--seed", type=int, default=42)
    parser.add_argument("--train-frac", type=float, default=0.85)
    parser.add_argument("--val-frac", type=float, default=0.05)
    parser.add_argument("--max-completion-rows", type=int, default=None)
    parser.add_argument("--max-records", type=int, default=None)
    parser.add_argument("--timeout-ms", type=int, default=5000)
    parser.add_argument("--memory-mb", type=int, default=256)
    parser.add_argument("--cpu-seconds", type=int, default=10)
    parser.add_argument(
        "--no-determinism-check",
        action="store_true",
        help="disable the sandbox determinism re-run",
    )
    parser.add_argument("--overwrite", action="store_true")
    parser.add_argument("--allow-secret-findings", action="store_true")
    parser.add_argument("--json", action="store_true", help="emit JSON summary")
    args = parser.parse_args(argv)

    try:
        result = build_passfail_pack(
            completion_label_paths=tuple(args.completion_labels),
            source_path=args.source,
            benchmark=args.benchmark,
            output_dir=args.out,
            sandbox_policy=policy_from_args(
                timeout_ms=args.timeout_ms,
                memory_mb=args.memory_mb,
                cpu_seconds=args.cpu_seconds,
                determinism_check=not args.no_determinism_check,
            ),
            seed=args.seed,
            train_frac=args.train_frac,
            val_frac=args.val_frac,
            max_completion_rows=args.max_completion_rows,
            max_records=args.max_records,
            overwrite=args.overwrite,
            allow_secret_findings=args.allow_secret_findings,
            command=("scripts/build-passfail-pack", *(argv or sys.argv[1:])),
        )
    except PassFailPackBuilderError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    if args.json:
        print(json.dumps(result.to_dict(), indent=2, sort_keys=True))
    else:
        print(f"pack: {result.output_dir}")
        print(f"records: {result.record_count}")
        print(f"pass_label_counts: {result.pass_label_counts}")
        print(f"pos_weight: {result.pos_weight:.6f}")
        print(f"manifest: {result.output_dir / 'manifest.json'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
