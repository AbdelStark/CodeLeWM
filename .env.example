# CodeLeWM local/Hugging Face automation settings.
# Copy to .env and fill real values locally. .env is ignored by git.

# Secrets
HF_TOKEN=hf_xxx
GITHUB_TOKEN=github_pat_xxx
OPENROUTER_API_KEY=openrouter_xxx

# Hugging Face repositories. Public publication is allowed after the
# license/source, manifest, secret-scan, and checkpoint-trust gates pass.
CODELEWM_HF_DATASET_REPO_ID=abdelstark/codelewm-public-shard
CODELEWM_HF_MODEL_REPO_ID=abdelstark/codelewm-transition-model
CODELEWM_HF_RESULTS_REPO_ID=abdelstark/codelewm-runs
CODELEWM_HF_PRIVATE=0

# Source checkout used inside HF Jobs.
CODELEWM_HF_GITHUB_REPO=https://github.com/AbdelStark/CodeLeWM.git
CODELEWM_HF_REF=main

# Job launcher defaults. Leave dry-run enabled until the issue gate says to spend compute.
CODELEWM_HF_JOBS_DRY_RUN=1
CODELEWM_HF_JOBS_FLAVOR=a10g-small
CODELEWM_HF_JOBS_TIMEOUT=6h
CODELEWM_HF_JOBS_DETACH=1
CODELEWM_HF_JOBS_NAMESPACE=
CODELEWM_HF_JOB_IMAGE=python:3.13-bookworm

# Pipeline mode.
# - smoke: current first-results fixture workflow; useful for validating infra.
# - scaled: requires CODELEWM_DATASET_BUILD_CONFIG and CODELEWM_TRAIN_CONFIG.
CODELEWM_HF_PIPELINE_MODE=smoke
CODELEWM_HF_RUN_ID=
CODELEWM_HF_OUTPUT_ROOT=.artifacts/hf
CODELEWM_HF_PUBLISH=1
CODELEWM_HF_PUBLISH_DRY_RUN=1

# Scaled mode inputs. The public shard config expects the HF source download
# below to populate .artifacts/hf-sources before dataset build runs.
CODELEWM_DATASET_BUILD_CONFIG=config/data/codelewm_public_shard_commitpackft_python.json
CODELEWM_TRAIN_CONFIG=config/train/scaled/codelewm_scaled_action_use_margin_gpu_a10g.yaml
CODELEWM_HF_TRAIN_EXECUTOR=torch
CODELEWM_HF_DEVICE=auto
CODELEWM_HF_INDEX_DEVICE=auto
CODELEWM_HF_INDEX_BATCH_SIZE=64
CODELEWM_HF_EVAL_SEED=0
CODELEWM_HF_SCORER_QUALITY_CONFIG=config/first_results/scorer_quality.json
CODELEWM_HF_RETRIEVAL_PRIOR_WEIGHT=1.0
CODELEWM_HF_RETRIEVAL_PRIOR_K=10

# HF CLI source prefetch for scaled mode. Keep this explicit so the remote job
# records where the public shard came from before training starts.
CODELEWM_HF_SOURCE_DATASET_REPO_ID=bigcode/commitpackft
CODELEWM_HF_SOURCE_DATASET_REPO_TYPE=dataset
CODELEWM_HF_SOURCE_DATASET_PATH=data/python/data.jsonl
CODELEWM_HF_SOURCE_DATASET_REVISION=main
CODELEWM_HF_SOURCE_LOCAL_DIR=.artifacts/hf-sources/commitpackft

# Planned v0.3 LLM + world-model harness. Keep dry-run enabled until the
# OpenRouter adapter issue has landed and the command path is validated.
CODELEWM_LLM_PROVIDER=openrouter
CODELEWM_LLM_MODEL=anthropic/claude-4.5-sonnet
CODELEWM_LLM_MAX_CANDIDATES=4
CODELEWM_LLM_TIMEOUT_SECONDS=120
CODELEWM_LLM_TEMPERATURE=0.2
CODELEWM_LLM_DRY_RUN=1
CODELEWM_LLM_PROVIDER_OPTIONS_JSON='{"sort":"price","zdr":true}'
CODELEWM_LLM_RETRY_LIMIT=2
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=CodeLeWM
