# CodeLeWM local/Hugging Face automation settings.
# Copy to .env and fill real values locally. .env is ignored by git.

# Secrets
HF_TOKEN=hf_xxx
GITHUB_TOKEN=github_pat_xxx

# Hugging Face repositories. Keep private until the license/source gate is signed off.
CODELEWM_HF_DATASET_REPO_ID=abdelstark/codelewm-public-shard
CODELEWM_HF_MODEL_REPO_ID=abdelstark/codelewm-transition-model
CODELEWM_HF_RESULTS_REPO_ID=abdelstark/codelewm-runs
CODELEWM_HF_PRIVATE=1

# Source checkout used inside HF Jobs.
CODELEWM_HF_GITHUB_REPO=https://github.com/AbdelStark/CodeLeWM.git
CODELEWM_HF_REF=main

# Job launcher defaults. Leave dry-run enabled until the issue gate says to spend compute.
CODELEWM_HF_JOBS_DRY_RUN=1
CODELEWM_HF_JOBS_FLAVOR=a10g-small
CODELEWM_HF_JOBS_TIMEOUT=6h
CODELEWM_HF_JOBS_DETACH=1
CODELEWM_HF_JOBS_NAMESPACE=
CODELEWM_HF_JOB_IMAGE=python:3.13-bookworm

# Pipeline mode.
# - smoke: current first-results fixture workflow; useful for validating infra.
# - scaled: requires CODELEWM_DATASET_BUILD_CONFIG and CODELEWM_TRAIN_CONFIG.
CODELEWM_HF_PIPELINE_MODE=smoke
CODELEWM_HF_RUN_ID=
CODELEWM_HF_OUTPUT_ROOT=.artifacts/hf
CODELEWM_HF_PUBLISH=1
CODELEWM_HF_PUBLISH_DRY_RUN=1

# Scaled mode inputs. These should land through #118/#119 before the real run.
CODELEWM_DATASET_BUILD_CONFIG=
CODELEWM_TRAIN_CONFIG=
CODELEWM_HF_TRAIN_EXECUTOR=torch
CODELEWM_HF_DEVICE=auto
CODELEWM_HF_EVAL_SEED=0
